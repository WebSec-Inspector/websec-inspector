# Copy to /opt/websec-inspector/.env on the server. Never commit the real file.
SITE_HOST=websec-YOUR-PUBLIC-IP-WITH-HYPHENS.sslip.io
POSTGRES_PASSWORD=
JWT_SECRET=
# Safe CPU defaults for the free 1-OCPU fallback. For a 2-OCPU VM these may be raised.
ZAP_CPU_LIMIT=1.0
BACKEND_CPU_LIMIT=0.75
WORKER_CPU_LIMIT=0.5

# Enable only for an audited first adoption after a verified backup.
SCHEMA_ADOPT_LEGACY=false

# PDF delivery: disabled until an external SMTP provider and authorized test inbox are configured.
REPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
REPORT_FROM_EMAIL=
# Local Mailpit/Mailhog only: SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_TLS_MODE=none.
# Credentials require starttls or tls; never enable plaintext authentication.
