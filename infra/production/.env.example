# Copy to /opt/websec-inspector/.env on the server. Never commit the real file.
SITE_HOST=websec-YOUR-PUBLIC-IP-WITH-HYPHENS.sslip.io
POSTGRES_PASSWORD=
JWT_SECRET=
# Safe CPU defaults for the free 1-OCPU fallback. For a 2-OCPU VM these may be raised.
ZAP_CPU_LIMIT=1.0
BACKEND_CPU_LIMIT=0.75
WORKER_CPU_LIMIT=0.5
