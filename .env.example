# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql://websec:websec@db:5432/inspector

# MongoDB
MONGODB_URL=mongodb://websec:websec@mongodb:27017/inspector_results?authSource=admin

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://websec:websec@rabbitmq:5672/

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=websec
MINIO_SECRET_KEY=websec-websec

# ZAP
ZAP_URL=http://zap:8080
ZAP_API_KEY=change-me

# E-mail
RESEND_API_KEY=

# PDF delivery: disabled until an external SMTP provider and authorized test inbox are configured.
REPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
REPORT_FROM_EMAIL=
# Local Mailpit/Mailhog only: SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_TLS_MODE=none.
# Credentials require starttls or tls; never enable plaintext authentication.
